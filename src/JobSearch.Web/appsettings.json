{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JobSearch": {
    "RequireRemote": true,
    "MinimumHourlyRate": 50,
    "PreferredHourlyRate": 70,
    "MinimumHoursPerWeek": 10,
    "MaximumHoursPerWeek": 25,
    "AvoidSecurityClearance": true,
    "PenalizeLikelyStaffingAgencies": true,
    "MaximumResultsPerSource": 200,
    "AllowedCountryCodes": ["US"],
    "SearchTerms": [".NET", "C#", "ASP.NET Core"],
    "PreferredEmploymentTypes": ["Contract", "PartTime", "Fractional"],
    "PreferredKeywords": ["C#", ".NET", "ASP.NET Core", "REST API", "Azure", "SQL Server", "PostgreSQL", "React", "Angular", "Umbraco", "modernization", "production support"],
    "SeniorityKeywords": ["senior", "lead", "staff", "principal", "architect"],
    "ExcludedKeywords": ["junior", "entry level", "entry-level", "onsite only", "on-site only"],
    "AsyncWorkKeywords": ["asynchronous", "async", "flexible schedule", "deliverables"]
  },
  "Database": {
    "Path": "data/jobsearch.db"
  },
  "ApplicantProfile": {
    "Path": "data/applicant-profile.json"
  },
  "ApplicationAutomation": {
    "Headless": false,
    "ArtifactDirectory": "data/application-artifacts",
    "AutoSubmitEnabledPlatforms": []
  },
  "JobSources": {
    "Jobicy": {
      "Enabled": true,
      "BaseUrl": "https://jobicy.com/api/v2/remote-jobs",
      "Geography": "usa",
      "Industry": "engineering",
      "CooldownMinutes": 60
    },
    "Greenhouse": {
      "Enabled": true,
      "BaseUrl": "https://boards-api.greenhouse.io/v1/boards",
      "CooldownMinutes": 60,
      "Boards": [
        { "Token": "livefront", "Company": "Livefront" },
        { "Token": "chainguard", "Company": "Chainguard" },
        { "Token": "jetbrains", "Company": "JetBrains" },
        { "Token": "55564patriot334567software868575745", "Company": "Patriot Software" },
        { "Token": "stackadapt", "Company": "StackAdapt" }
      ]
    },
    "Lever": {
      "Enabled": true,
      "BaseUrl": "https://api.lever.co/v0/postings",
      "CooldownMinutes": 60,
      "Boards": [
        { "Token": "trility", "Company": "Trility Consulting" },
        { "Token": "lwolf", "Company": "Lone Wolf Technologies" },
        { "Token": "filevine", "Company": "Filevine" },
        { "Token": "aerostrat", "Company": "Aerostrat" }
      ]
    }
  }
}
