@page "/applications/{Id:guid}"
@inject IApplicationRepository Repository
@inject IApplicantProfileStore ProfileStore
@inject ApplicationService Service
@inject ApplicationGuidanceService Guidance

<PageTitle>Application Review | JobSearch</PageTitle>
@if (application is null) { <div class="empty-state">Loading application...</div> }
else {
    <a class="back-link" href="/applications"><span aria-hidden="true">&#8592;</span> Applications</a>
    <header class="application-header"><div><p class="eyebrow">@application.Company</p><h1>@application.JobTitle</h1><div class="metadata"><span>@application.Platform</span><span>Created @application.CreatedAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span></div></div><span class="application-status status-@application.Status.ToString().ToLowerInvariant()">@Guidance.StatusLabel(application.Status)</span></header>

    <ol class="application-stepper" aria-label="Application progress">
        @foreach (var stage in progress)
        {
            <li class="@(stage.IsComplete ? "complete" : null) @(stage.IsCurrent ? "current" : null) @(stage.RequiresAttention ? "attention" : null)" aria-current="@(stage.IsCurrent ? "step" : null)"><span aria-hidden="true">@(stage.IsComplete ? "✓" : ((int)stage.Stage + 1).ToString())</span><strong>@stage.Label</strong>@if (stage.RequiresAttention) { <small>Needs your input</small> }</li>
        }
    </ol>

    @if (!string.IsNullOrWhiteSpace(message)) { <div class="fetch-result @(isError ? "fetch-warning" : "fetch-success")" role="status">@message</div> }

    <section class="next-action-panel @(nextAction.RequiresAttention ? "requires-attention" : null)" aria-labelledby="next-action-heading">
        <div><span>Next action</span><h2 id="next-action-heading">@nextAction.Title</h2><p>@nextAction.Explanation</p>@if (nextAction.StartsAutomation) { <small>Automatic submission is disabled. Browser filling always stops before submission.</small> }</div>
        @if (nextAction.Target == ApplicationActionTarget.AnswerQuestions)
        {
            <a class="btn-primary-action" href="#required-questions">@nextAction.ButtonLabel</a>
        }
        else if (!nextAction.IsInformationalOnly && nextAction.Target != ApplicationActionTarget.None)
        {
            <button class="btn-primary-action" @onclick="RunPrimaryActionAsync">@nextAction.ButtonLabel</button>
        }
    </section>

    <div class="application-review-layout">
        <main class="detail-main">
            @if (application.Status == ApplicationWorkflowStatus.NeedsInput)
            {
                <section id="required-questions" class="detail-section needs-input-panel" aria-labelledby="questions-heading"><div class="section-heading"><h2 id="questions-heading">Employer questions</h2><span>@UnresolvedQuestions.Count required</span></div>
                    <p class="section-intro">Review each answer before resuming. Internal form fields and hidden validation controls are not shown here.</p>
                    @foreach (var question in UnresolvedQuestions)
                    {
                        <div class="question-editor">
                            <div class="question-heading"><strong>@question.Question</strong><span>@(question.IsRequired ? "Required" : "Optional")</span></div>
                            @if (question.Options.Count > 0)
                            {
                                <label for="@($"question-{question.Id}")">Approved answer</label>
                                <select id="@($"question-{question.Id}")" value="@questionState.Answer(question)" @onchange="eventArgs => questionState.SetAnswer(question.Id, eventArgs.Value?.ToString())"><option value="">Choose an answer</option>@foreach (var option in question.Options) { <option value="@option">@option</option> }</select>
                            }
                            else
                            {
                                <label for="@($"question-{question.Id}")">Approved answer</label>
                                <textarea id="@($"question-{question.Id}")" rows="4" value="@questionState.Answer(question)" @oninput="eventArgs => questionState.SetAnswer(question.Id, eventArgs.Value?.ToString())"></textarea>
                            }
                            @if (!string.IsNullOrWhiteSpace(question.DraftAnswer)) { <div class="answer-evidence"><strong>Suggested from verified evidence</strong><p>@question.DraftAnswer</p><span>Draft only · human approval required</span></div> }
                            <label class="checkbox-field"><input type="checkbox" checked="@questionState.SaveForFuture(question.Id)" @onchange="eventArgs => questionState.SetSaveForFuture(question.Id, eventArgs.Value is true)" /> Save this answer for similar future questions</label>
                            <div class="form-actions"><button class="btn-secondary-action" @onclick="() => DraftQuestionAsync(question.Id)">Draft from evidence</button><button class="btn-secondary-action" disabled="@string.IsNullOrWhiteSpace(questionState.Answer(question))" @onclick="() => SaveQuestionAsync(question.Id)">Save answer</button></div>
                        </div>
                    }
                    <div class="resume-actions"><div><strong>Ready to continue?</strong><span>All required answers will be saved before the same application is resumed.</span><small>Automatic submission is disabled.</small></div><button class="btn-primary-action" disabled="@(!CanSaveAndResume)" @onclick="SaveAndResumeAsync">Save &amp; Resume Application</button></div>
                </section>
            }

            @if (application.Status == ApplicationWorkflowStatus.ReadyToSubmit && readyReview is not null)
            {
                <section class="detail-section ready-review" aria-labelledby="final-review-heading"><div class="section-heading"><h2 id="final-review-heading">Final review</h2><span>Human submission required</span></div>
                    <div class="submission-boundary"><strong>Automation finished filling this application.</strong><span>Nothing has been submitted yet.</span></div>
                    <div class="review-group"><h3>Job</h3><dl class="review-facts"><div><dt>Company</dt><dd>@readyReview.Company</dd></div><div><dt>Title</dt><dd>@readyReview.JobTitle</dd></div><div><dt>Source / ATS</dt><dd>@readyReview.Source</dd></div></dl></div>
                    <div class="review-group"><h3>Resume</h3><dl class="review-facts"><div><dt>File used</dt><dd>@readyReview.ResumeFileName</dd></div><div><dt>Upload</dt><dd>@(readyReview.ResumeUploaded ? "Verified uploaded" : "Not verified — review required")</dd></div></dl></div>
                    <div class="review-group"><h3>Contact and profile</h3><dl class="review-facts"><div><dt>Name</dt><dd>@readyReview.Contact.Name</dd></div><div><dt>Email</dt><dd>@readyReview.Contact.Email</dd></div><div><dt>Phone</dt><dd>@readyReview.Contact.Phone</dd></div><div><dt>Location</dt><dd>@readyReview.Contact.Location</dd></div><div><dt>LinkedIn</dt><dd>@(readyReview.Contact.LinkedInAvailable ? "Included" : "Not provided")</dd></div></dl></div>
                    <div class="review-group"><h3>Approved answers</h3>@if (readyReview.Answers.Count == 0) { <p class="muted-copy">No job-specific written answers were recorded.</p> } else { <div class="final-answer-list">@foreach (var answer in readyReview.Answers) { <article><strong>@answer.Question</strong><p>@answer.Answer</p></article> }</div> }</div>
                    <div class="review-group"><h3>Optional fields left blank</h3><ul class="review-list">@foreach (var item in readyReview.OptionalFieldsLeftBlank) { <li>@item</li> }</ul></div>
                    @if (readyReview.Warnings.Count > 0) { <div class="review-group warning-group"><h3>Warnings requiring review</h3><ul class="review-list">@foreach (var warning in readyReview.Warnings) { <li>@warning</li> }</ul></div> }
                    <div class="manual-submit-panel"><div><strong>After you submit on the employer's website</strong><span>Record it here so the application timeline and dashboard stay accurate.</span></div><button class="btn-secondary-action" @onclick="() => showSubmissionConfirmation = true">Mark as Submitted</button></div>
                    @if (showSubmissionConfirmation)
                    {
                        <div class="confirmation-panel" role="dialog" aria-modal="true" aria-labelledby="confirm-submit-heading"><h3 id="confirm-submit-heading">Did you submit this application on the employer's website?</h3><p>This only updates JobSearch. It will not interact with the employer form.</p><div class="form-actions"><button class="btn-secondary-action" @onclick="() => showSubmissionConfirmation = false">Cancel</button><button class="btn-primary-action" @onclick="ConfirmSubmittedAsync">Yes, Mark Submitted</button></div></div>
                    }
                </section>
            }
            else
            {
                <section class="detail-section"><div class="section-heading"><h2>Application package</h2><span>Private local workspace</span></div><dl class="review-facts"><div><dt>Application</dt><dd><a href="@application.ApplicationUrl" target="_blank" rel="noopener noreferrer">Employer form &#8599;</a></dd></div><div><dt>Resume</dt><dd>@Path.GetFileName(application.ResumePath)</dd></div><div><dt>Filling mode</dt><dd>Review before submit</dd></div></dl></section>
                <section class="detail-section"><div class="section-heading"><h2>Applicant data</h2><span>Values available to filling</span></div><dl class="review-facts"><div><dt>Name</dt><dd>@($"{profile.LegalFirstName} {profile.LegalLastName}".Trim())</dd></div><div><dt>Email</dt><dd>@MaskEmail(profile.Email)</dd></div><div><dt>Phone</dt><dd>@MaskPhone(profile.Phone)</dd></div><div><dt>Location</dt><dd>@ValueOrNone(string.Join(", ", new[] { profile.City, profile.State, profile.Country }.Where(value => !string.IsNullOrWhiteSpace(value))))</dd></div><div><dt>LinkedIn</dt><dd>@(string.IsNullOrWhiteSpace(profile.LinkedInUrl) ? "Not provided" : "Available")</dd></div></dl><a href="/profile">Edit applicant profile</a></section>
            }
        </main>

        <aside class="detail-sidebar">
            <section class="side-panel safety-panel"><h2>Submission safety</h2><p>Automatic submission is disabled. JobSearch fills approved information, then waits for you.</p></section>
            @if (application.Status is not ApplicationWorkflowStatus.Submitted and not ApplicationWorkflowStatus.Withdrawn) { <section class="side-panel"><h2>Secondary actions</h2><button class="btn-secondary-action full-button" @onclick="WithdrawAsync">Cancel application</button></section> }
            <details class="side-panel developer-details"><summary>Technical details</summary><dl class="review-facts"><div><dt>Internal state</dt><dd>@application.Status</dd></div><div><dt>Browser run</dt><dd>@ValueOrNone(application.BrowserRunId)</dd></div></dl></details>
            <details class="side-panel event-history"><summary>Application history</summary><div class="timeline">@foreach (var item in application.Events) { <div class="timeline-item"><strong>@EventLabel(item.Type)</strong><time>@item.OccurredAtUtc.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</time><p>@item.Message</p></div> }</div></details>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private JobApplication? application;
    private ApplicantProfile profile = new();
    private readonly ApplicationQuestionReviewState questionState = new();
    private ApplicationNextAction nextAction = new("Loading", "", "", ApplicationActionTarget.None, false, false, true);
    private IReadOnlyList<ApplicationStageState> progress = [];
    private ReadyToSubmitReview? readyReview;
    private string message = string.Empty;
    private bool isError;
    private bool showSubmissionConfirmation;
    private IReadOnlyList<PendingApplicationQuestion> UnresolvedQuestions => application?.Questions.Where(value => !value.IsResolved).ToArray() ?? [];
    private bool CanSaveAndResume => UnresolvedQuestions.Count > 0 && questionState.CanSaveAll(UnresolvedQuestions);

    protected override async Task OnParametersSetAsync() { profile = await ProfileStore.GetAsync(); SetApplication(await Repository.GetAsync(Id)); }
    private async Task ExecuteAsync(Func<Task<JobApplication>> action, string success) { try { isError = false; SetApplication(await action()); message = success; } catch (Exception exception) { isError = true; message = exception.Message; SetApplication(await Repository.GetAsync(Id)); } }
    private Task PrepareAsync() => ExecuteAsync(() => Service.PrepareAsync(application!.JobPostingId), "Application package prepared. Review it before browser filling.");
    private Task ApproveAsync() => ExecuteAsync(() => Service.ApproveAsync(Id), "Application approved. It is ready for guided filling.");
    private Task RunAsync() => ExecuteAsync(() => Service.RunAsync(Id), "Browser filling completed. Review the next action.");
    private Task WithdrawAsync() => ExecuteAsync(() => Service.WithdrawAsync(Id), "Application removed from the active workflow.");
    private async Task RunPrimaryActionAsync() { switch (nextAction.Target) { case ApplicationActionTarget.Prepare: await PrepareAsync(); break; case ApplicationActionTarget.Approve: await ApproveAsync(); break; case ApplicationActionTarget.RunAutomation: await RunAsync(); break; case ApplicationActionTarget.FocusBrowser: await FocusBrowserAsync(); break; } }
    private async Task FocusBrowserAsync() { try { isError = false; var focused = await Service.FocusBrowserAsync(Id); message = focused ? "The existing employer browser window is ready for your final review." : "The original filled browser session is no longer open. JobSearch did not start a new form. Review the recorded package before deciding whether to run filling again."; isError = !focused; } catch (Exception exception) { isError = true; message = exception.Message; } }
    private Task SaveQuestionAsync(Guid questionId) { var question = application!.Questions.Single(value => value.Id == questionId); return ExecuteAsync(() => Service.AnswerQuestionAsync(Id, questionId, questionState.Answer(question), questionState.SaveForFuture(questionId)), "Answer saved. Complete every required question before resuming."); }
    private async Task SaveAndResumeAsync() { var pending = UnresolvedQuestions.ToArray(); if (pending.Any(value => string.IsNullOrWhiteSpace(questionState.Answer(value)))) { isError = true; message = "Every required question needs an approved answer."; return; } foreach (var question in pending) await Service.AnswerQuestionAsync(Id, question.Id, questionState.Answer(question), questionState.SaveForFuture(question.Id)); await RunAsync(); }
    private async Task DraftQuestionAsync(Guid questionId) { await ExecuteAsync(() => Service.DraftQuestionAsync(Id, questionId), "Draft created from verified evidence. Review it before saving."); var question = application!.Questions.Single(value => value.Id == questionId); questionState.SetAnswer(questionId, question.DraftAnswer); }
    private async Task ConfirmSubmittedAsync() { showSubmissionConfirmation = false; await ExecuteAsync(() => Service.MarkSubmittedAsync(Id), "Application recorded as submitted."); }
    private void SetApplication(JobApplication? value) { application = value; questionState.Synchronize(value); if (value is null) return; nextAction = Guidance.Resolve(value.Status, value.Questions.Count(question => !question.IsResolved)); progress = Guidance.Progress(value.Status); readyReview = value.Status == ApplicationWorkflowStatus.ReadyToSubmit ? Guidance.ReadyReview(value, profile) : null; }
    private static string EventLabel(ApplicationEventType value) => value switch { ApplicationEventType.AutomationStarted => "Filling started", ApplicationEventType.NeedsInput => "Your input requested", ApplicationEventType.ReadyToSubmit => "Ready for final review", ApplicationEventType.AnswerUsed => "Approved answer used", ApplicationEventType.FieldFilled => "Field filled", _ => value.ToString() };
    private static string ValueOrNone(string? value) => string.IsNullOrWhiteSpace(value) ? "Not available" : value;
    private static string MaskEmail(string value) => string.IsNullOrWhiteSpace(value) || !value.Contains('@') ? "Not provided" : $"{value[0]}***{value[value.IndexOf('@')..]}";
    private static string MaskPhone(string value) { var digits = new string((value ?? string.Empty).Where(char.IsDigit).ToArray()); return digits.Length >= 4 ? $"Ending in {digits[^4..]}" : "Not provided"; }
}
